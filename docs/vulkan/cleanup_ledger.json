  "operating_policy": {
    "track": "background",
    "rule": "Forward graph/runtime work creates deletion eligibility; cleanup removes eligible code without delaying the executor critical path.",
    "archive": "Git preserves inactive implementations. The tree preserves active contracts, current evidence, and concise rejection records.",
    "new_surface_policy": "Every discovered surface must be named explicitly in exactly one ledger entry. There is no default classification.",
    "test_policy": "Mechanism-only tests are deleted with the mechanism. Behavioral tests that pin a bug class survive."
  },
  "baseline_policy": {
    "comparison_surfaces": [
      "plain concrete eager",
      "VulkanGraphProgram"
    ],
    "excluded_as_deletion_bars": [
      "opt-in canaries",
      "benchmark-harness-only bridges",
      "replay and compiled-session lanes"
    ],
    "record_at_deletion": [
      "commit",
      "adapter and driver",
      "workload and inputs",
      "supported route",
      "correctness result",
      "fallback and readback counters",
      "submit-origin counters",
      "peak memory",
      "latency"
    ]
  },
  "compatibility_audit": {
    "status": "empty",
    "scope": "fork-owned Vulkan operator schemas and custom classes",
    "checked_on": "2026-07-14",
    "deployment": "DepthExtractor loaders in the sibling DeepDesktop deployment checkouts",
    "evidence": [
      "Depth Anything V2 loaders construct Python modules and load .pth state dicts with weights_only=True.",
      "The deployed loader sources contain no torch.jit.load or vulkan_prepack references.",
      "No .pt, .pth, .ts, .jit, or .torchscript artifacts are checked into the deployed loader/template roots outside their vendored PyTorch checkout.",
      "TensorRT .ts cache names are produced and consumed only by TensorRT loader variants and do not establish Vulkan schema compatibility."
    ],
    "recheck_when": "a deployment starts loading serialized TorchScript, ExportedProgram, or custom-class artifacts"
  },
  "scope_decisions": [
    {
      "id": "qwen_gated_delta_orchestration",
      "decision": "out_of_scope",
      "status": "deleted",
      "basis": [
        "Qwen is not in the five-model Vulkan coverage corpus.",
        "The deployed Qwen loader targets Qwen 2.5 through transformers and has no Vulkan custom-op callsite.",
        "Repository reachability outside tests ends inside the Qwen/gated-delta implementation, registration, and legacy planning caches."
      ],
      "removed_paths": [
        "aten/src/ATen/native/vulkan/glsl/gated_delta_recurrent_buffer.glsl",
        "aten/src/ATen/native/vulkan/ops/GatedDelta.cpp",
        "aten/src/ATen/native/vulkan/ops/GatedDelta.h",
        "aten/src/ATen/native/vulkan/ops/QwenLinearAttention.cpp",
        "aten/src/ATen/native/vulkan/ops/QwenLinearAttention.h"
      ],
      "scan_roots": [
        "aten/src/ATen/native/vulkan"
      ],
      "forbidden_code_symbols": [
        "QwenLinearAttention",
        "GatedDeltaSplit",
        "run_gated_delta_rule_",
        "run_scheduled_gated_delta_rule_",
        "gated_delta_recurrent_buffer"
      ],
      "consequence": "The Qwen linear-attention context, gated-delta operators and shader, mechanism tests, and dedicated GatedDeltaSplit planning cache were deleted. Generic Request.cpp label inference remains Migration until its separate explicit-field and lane-parity gate is met."
    },
    {
      "id": "linear_pending_flush_deferral_canary",
      "decision": "retire_experiment",
      "status": "deleted",
      "basis": [
        "The canary was default-off and reachable only through explicit environment orchestration.",
        "Its DAv2 result proved that 48 plain-linear flushes could be deferred with bit-for-bit output parity, but did not establish a supported eager default or a graph-owned replacement.",
        "Supported eager linear retains its explicit pending-command flush and submit-origin accounting while graph programs pursue packed-context ownership directly."
      ],
      "scan_roots": [
        "aten/src/ATen/native/vulkan",
        "scripts/benchmarks",
        "test"
      ],
      "forbidden_code_symbols": [
        "PYTORCH_VULKAN_LINEAR_PENDING_FLUSH_DEFERRAL",
        "linear_pending_flush_deferral",
        "LinearPendingFlushDeferralContract"
      ],
      "consequence": "The canary context-retention owner, eager branch, environment registration, evidence-harness exemption, and mechanism test were deleted. The supported default linear flush and its submit-origin regression test remain."
    },
    {
      "id": "eager_region_observer_pocs",
      "decision": "retire_experiment",
      "status": "deleted",
      "basis": [
        "The lazy-chain, deferred-region, runtime shader compile, and command-list surfaces were default-off behavior-neutral observers over eager op-hit backlogs.",
        "Their own plans recorded execution_enabled=0 because they lacked tensor SSA handles, producer-consumer edges, output ownership, descriptor capture, barrier execution, and alias proof.",
        "Graph lowering and VulkanGraphProgram now own semantic regions and command partitions directly, so retaining a second backlog-based planning model would preserve the rejected architecture rather than reusable execution code."
      ],
      "scan_roots": [
        "aten/src/ATen/native/vulkan",
        "scripts",
        "test"
      ],
      "forbidden_code_symbols": [
        "PYTORCH_VULKAN_LAZY_CHAIN_LOG",
        "PYTORCH_VULKAN_DEFERRED_EXECUTION_LOG",
        "PYTORCH_VULKAN_DEFERRED_REGION_PLAN_LOG",
        "PYTORCH_VULKAN_RUNTIME_SHADER_COMPILE_LOG",
        "PYTORCH_VULKAN_RUNTIME_COMMAND_LIST_LOG",
        "note_vulkan_lazy_chain_op",
        "flush_vulkan_lazy_chain_boundary",
        "note_vulkan_deferred_region",
        "VulkanRuntimeShaderCompileTrace.v0",
        "VulkanRuntimeCommandListPlanTrace.v0"
      ],
      "consequence": "The eager backlog observer state, flush-boundary hooks, behavior-neutral runtime compiler and command-list planners, provenance-only deferred handles, mechanism tests, and stack-era documentation were deleted. Failure logging, fallback/readback counters, submit-origin accounting, transition diagnostics, and GPU timestamp attribution remain active."
    }
  ],
